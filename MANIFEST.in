# Include documentation
include README.md
include LICENSE
include CONTRIBUTING.md
include CHANGELOG.md

# Include requirements files
include requirements.txt
include requirements-dev.txt

# Include configuration files
include pyproject.toml
include setup.py
include tox.ini
include .pre-commit-config.yaml

# Include documentation
recursive-include docs *.md *.rst *.txt *.png *.jpg *.svg
recursive-include docs/_static *
recursive-include docs/_templates *

# Include examples
recursive-include examples *.json *.py *.md *.cml

# Include schemas
recursive-include schemas *.py *.json

# Include tests
recursive-include tests *.py *.json *.cml *.txt

# Exclude development artifacts
exclude .gitignore
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
recursive-exclude * *.log
recursive-exclude * .DS_Store
recursive-exclude .kiro *
recursive-exclude .git *
recursive-exclude .github *
exclude test_*.py
exclude *_output.cml
exclude output.cml
exclude *.log